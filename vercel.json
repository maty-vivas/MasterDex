{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/pokeapi/v2/:path*/",
      "destination": "/api/pokeapi/v2?__resourcePath=:path*"
    },
    {
      "source": "/api/pokeapi/v2/:path*",
      "destination": "/api/pokeapi/v2?__resourcePath=:path*"
    },
    {
      "source": "/pokemon/:path*",
      "destination": "/"
    }
  ]
}
